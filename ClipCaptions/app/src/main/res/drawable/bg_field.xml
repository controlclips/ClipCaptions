<?xml version="1.0" encoding="utf-8"?>
<!-- A drop-down field: an outlined box with a chevron on the right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cc_card" />
            <stroke android:width="1dp" android:color="@color/cc_muted" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_chevron_down" android:gravity="end|center_vertical" android:right="14dp" />
</layer-list>
