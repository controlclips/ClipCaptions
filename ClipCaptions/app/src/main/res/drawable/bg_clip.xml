<?xml version="1.0" encoding="utf-8"?>
<!-- The sample "video" in the main screen's header. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cc_clip" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:width="220dp" android:height="220dp" android:gravity="top|end" android:top="-90dp" android:right="-40dp">
        <shape android:shape="oval">
            <solid android:color="@color/cc_clip_glow" />
        </shape>
    </item>
</layer-list>
